# Template configuration. Copy to .env and fill in your own backend values.
# All keys are required — they generate BuildConfig fields at build time.

# Base URL for your Ayne Mobile Backend deployment
API_BASE_URL=https://your-backend.example.com

# Endpoint overrides (normally derived from API_BASE_URL, but the keys must exist)
VISION_API_URL=https://your-backend.example.com/api/see-and-describe
READ_TEXT_API_URL=https://your-backend.example.com/api/read-text
ASK_QUESTION_API_URL=https://your-backend.example.com/api/ask-question
ADDIS_REALTIME_STREAM_URL=https://your-backend.example.com/api/addis-realtime/stream
