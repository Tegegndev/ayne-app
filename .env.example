# Base URL for the Ayne Mobile Backend.
# BuildConfig.API_BASE_URL is generated from this by the secrets-gradle-plugin.
API_BASE_URL=https://ayne-roan.vercel.app

# Explicit endpoint overrides. Optional — endpoints are normally derived from
# API_BASE_URL at runtime, but BuildConfig fields must exist, so keep these keys.
VISION_API_URL=https://ayne-roan.vercel.app/api/see-and-describe
READ_TEXT_API_URL=https://ayne-roan.vercel.app/api/read-text
ASK_QUESTION_API_URL=https://ayne-roan.vercel.app/api/ask-question
