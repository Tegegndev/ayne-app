<?xml version="1.0" encoding="utf-8"?>
<!--
  Ayne brand mark: an eye whose iris is a camera aperture.
  Geometry lives inside the 72dp adaptive-icon safe zone (18..90) so launchers
  can mask the icon to any shape without clipping the symbol.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Eye outline: almond formed by two arcs meeting at 28,54 and 80,54 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M28,54 C40,37 68,37 80,54 C68,71 40,71 28,54 Z"
        android:strokeColor="#FFD600"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Iris: hexagonal camera aperture -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,42.5 L63.96,48.25 L63.96,59.75 L54,65.5 L44.04,59.75 L44.04,48.25 Z"
        android:strokeColor="#FFD600"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Pupil -->
    <path
        android:fillColor="#FFD600"
        android:pathData="M54,54m-3.8,0a3.8,3.8 0 1,1 7.6,0a3.8,3.8 0 1,1 -7.6,0" />
</vector>
